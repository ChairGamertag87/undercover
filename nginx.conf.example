# /etc/nginx/sites-available/undercover
# Le WebSocket vit sur /ws, il faut donc les entetes Upgrade.

server {
    listen 80;
    listen [::]:80;
    server_name undercover.exemple.fr;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name undercover.exemple.fr;

    ssl_certificate     /etc/letsencrypt/live/undercover.exemple.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/undercover.exemple.fr/privkey.pem;

    access_log /var/log/nginx/undercover.access.log;
    error_log  /var/log/nginx/undercover.error.log;

    location / {
        proxy_pass http://127.0.0.1:8091;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws {
        proxy_pass http://127.0.0.1:8091;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
