# /etc/systemd/system/undercover.service  (alternative sans Docker)
[Unit]
Description=Undercover online
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/undercover
Environment=PORT=8091
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
